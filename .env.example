# Environment Variables Template
# Copy to .env.local and fill in your actual values

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/fitness_db"
DIRECT_URL="postgresql://username:password@localhost:5432/fitness_db"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-32-character-secret-key-here"

# Google OAuth (Required for authentication)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email Configuration (Optional)
EMAIL_SERVER="smtp://username:password@smtp.gmail.com:587"
EMAIL_PORT="587"
EMAIL_USERNAME="your-email@gmail.com"
EMAIL_PASSWORD="your-email-password"
EMAIL_FROM="your-email@gmail.com"

# Image APIs (Optional - for enhanced image loading)
# Get free API key from https://www.pexels.com/api/
PEXELS_API_KEY="your-pexels-api-key-here"

# Alternative: Unsplash API (Optional)
# Get free API key from https://unsplash.com/developers
UNSPLASH_ACCESS_KEY="your-unsplash-access-key-here"

# Development Environment
NODE_ENV="development"
NEXT_PUBLIC_ENV="development"